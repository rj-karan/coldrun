# Maintainer: KARAN RJ <rjkaran418 at gmail dot com>
pkgname=coldrun-git
pkgver=0.4.0.r0.g0000000
pkgrel=1
pkgdesc="Fetch, vet and sandbox any downloaded script in one command (git main)"
arch=(any)
url="https://github.com/rj-karan/coldrun"
license=(MIT)
depends=(python bubblewrap python-typer python-rich uv)
makedepends=(git python-build python-installer python-hatchling)
optdepends=(
  'python-yara: YARA rules that vet scripts in any language'
  'semgrep: Semgrep rules that vet Python scripts'
  'podman: Python 2 scripts, which run in a container image'
  'nodejs: Node scripts'
  'npm: Node dependencies'
  'go: Go scripts'
  'ruby: Ruby scripts and gems'
)
provides=(coldrun)
conflicts=(coldrun)
source=("coldrun::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd coldrun
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd coldrun
  python -m build --wheel --no-isolation
}

package() {
  cd coldrun
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/man/coldrun.1 "$pkgdir/usr/share/man/man1/coldrun.1"
  install -Dm644 packaging/completions/coldrun.bash \
    "$pkgdir/usr/share/bash-completion/completions/coldrun"
  install -Dm644 packaging/completions/_coldrun "$pkgdir/usr/share/zsh/site-functions/_coldrun"
  install -Dm644 packaging/completions/coldrun.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/coldrun.fish"
}
